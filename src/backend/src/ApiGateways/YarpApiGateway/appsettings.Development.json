{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/billing-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "billing-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://billing.api:8080"
          }
        }
      }
    }
  }
}